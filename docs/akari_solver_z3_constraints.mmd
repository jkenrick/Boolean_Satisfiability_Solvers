flowchart TD
    inputRules[/"KNF rules: literals and minimum; assignment"/] --> requireZ3[["require_z3(): check package"]]
    requireZ3 -->|"Missing Z3"| failedSearch(["Raise RuntimeError"])
    requireZ3 --> createSolver["Create Boolean variables, cached Not terms, fresh z3.Solver"]
    createSolver --> nextRule{"Another constraint?"}
    nextRule -->|"Yes"| skipRule{"minimum <= 0?"}
    skipRule -->|"Yes; already satisfied"| nextRule
    skipRule -->|"No"| impossibleRule{"minimum > literal count?"}
    impossibleRule -->|"Yes"| noModel(["Return None"])
    impossibleRule -->|"No"| mapLiterals["Map signed IDs to Bool or Not"]
    mapLiterals --> threshold{"Threshold?"}
    threshold -->|"minimum = 1"| addOr["Add z3.Or(terms)"]
    threshold -->|"Otherwise, minimum = count"| addAll["Assert every term"]
    threshold -->|"Otherwise"| addPb["Add z3.PbGe with unit weights"]
    addOr --> nextRule
    addAll --> nextRule
    addPb --> nextRule
    nextRule -->|"No"| assumptions["Assert caller-supplied Boolean assignments"]
    assumptions --> checkSolver["solver.check(): Z3 performs search and learning"]
    checkSolver --> status{"Z3 status?"}
    status -->|"UNSAT"| noModel
    status -->|"Unknown"| failedSearch
    status -->|"SAT"| readModel["Read solver.model(); complete unused variables"]
    readModel --> returnModel(["Return Boolean assignment; index 0 unused"])

    style noModel fill:#FFECBD,stroke:#FFC943
    style failedSearch fill:#FFCDC2,stroke:#FF7556
    style returnModel fill:#CDF4D3,stroke:#66D575
